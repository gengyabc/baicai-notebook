{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/vault-query-router/index.ts",
    ".opencode/plugins/secure-plugin-access.ts"
  ],
  "permission": {
    "bash": {
      "node -e*": "deny",
      "bun -e*": "deny",
      "bun eval*": "deny",
      "node *cross-keychain*": "deny",
      "node *keytar*": "deny",
      "bun *cross-keychain*": "deny",
      "bun *keytar*": "deny",
      "bun run .opencode/scripts/env-registry.mjs get *": "deny",
      "bun .opencode/scripts/env-registry.mjs get *": "deny",
      "security find-generic-password*": "deny",
      "security add-generic-password*": "deny",
      "security delete-generic-password*": "deny",
      "security dump-keychain*": "deny",
      "security find*": "deny"
    },
    "edit": {
      ".opencode/plugin-allowlist.json": "deny"
    },
    "read": {
      "**/secrets/**": "deny",
      "**/temp/**/fill_data.json": "deny"
    }
  }
}
